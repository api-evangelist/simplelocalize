        {
          "id": "d730a568-6245-46aa-8e30-6623fc974349",
          "name": "List Translations",
          "request": {
            "name": "List Translations",
            "description": {
              "content": "Retrieve translations with filtering and pagination. Supports filtering by key, language, namespace, text content, review status, and customer ID. Returns paginated results with up to 500 items per page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "translations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "text",
                  "value": "<string>",
                  "description": "Search translated text using case-insensitive partial matching"
                },
                {
                  "disabled": false,
                  "key": "textStatus",
                  "value": "<string>",
                  "description": "Filter by translation completeness"
                },
                {
                  "disabled": false,
                  "key": "reviewsStatus",
                  "value": "<string>",
                  "description": "Filter by review status"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "Exact match filter for translation key"
                },
                {
                  "disabled": false,
                  "key": "namespace",
                  "value": "<string>",
                  "description": "Exact match filter for translation namespace"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Exact match filter for language identifier"
                },
                {
                  "disabled": false,
                  "key": "customerId",
                  "value": "<string>",
                  "description": "Filter for customer-specific translations"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Pagination page number"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "100",
                  "description": "Results per page (maximum 500)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
